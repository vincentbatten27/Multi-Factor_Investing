    "\n",
    "# combine the 3 dfs to have a total future df\n",
    "total_futures_df_returns = pd.concat([MKT_RF_futures,s_1, s_2, h_1, h_2], axis= 1).dropna()\n",
    "total_futures_df_returns.columns = ['SPY', 'IWM', 'IWB', 'IWD', 'IWF']\n",
