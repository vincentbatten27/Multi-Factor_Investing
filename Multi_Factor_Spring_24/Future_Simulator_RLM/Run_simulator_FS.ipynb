    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import norm\n",
    "\n",
    "# 1) Load and clean\n",
    "csv_path = \"explored_sortino2020.csv\"      # adjust path if needed\n",
    "df   = pd.read_csv(csv_path, header=None)  # entire file has no header row\n",
    "data = df[3].values[1:].astype(float)      # skip first entry if it’s a text label\n",
    "\n",
    "# 2) Build combined plot\n",
    "fig, ax = plt.subplots(figsize=(8, 5))\n",
    "\n",
    "# Histogram (count scale)\n",
    "counts, bins, _ = ax.hist(data, bins=10, edgecolor='black')\n",
    "\n",
    "# Normal curve scaled to match counts\n",
    "mu,  sigma     = data.mean(), data.std(ddof=1)\n",
    "n,  bin_width  = len(data), bins[1] - bins[0]\n",
    "x              = np.linspace(bins[0], bins[-1], 250)\n",
    "y              = norm.pdf(x, mu, sigma) * n * bin_width\n",
    "ax.plot(x, y, '--', color='orange', linewidth=2,\n",
    "        label=\"Normal (scaled to counts)\")\n",
    "\n",
    "# 3) Labels and cosmetics\n",
    "ax.set_title('Sortino Reward Histogram (SP 500 Optimized Portfolio / SP 500)')\n",
    "ax.set_xlabel('Sortino Reward')\n",
    "ax.set_ylabel('Count')\n",
    "ax.legend()\n",
    "ax.grid(True)\n",
    "\n",
    "plt.show()\n"
   ]
  },
