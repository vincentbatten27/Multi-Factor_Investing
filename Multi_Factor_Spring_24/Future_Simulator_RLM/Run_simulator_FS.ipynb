    "def current_date():\n",
    "    global today\n",
    "    global os_start\n",
    "    global os_end\n",
    "    global n_year_before\n",
    "    global n_year_after\n",
    "    from datetime import datetime, timedelta\n",
    "    today = datetime.today()\n",
    "    one_year_before = today - timedelta(days=365)\n",
    "    os_start = today - timedelta(days=365)\n",
    "    two_months_before = os_start - timedelta(days=2*30)\n",
