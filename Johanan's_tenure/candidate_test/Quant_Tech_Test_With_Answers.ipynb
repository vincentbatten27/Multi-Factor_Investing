   "source": [
    "### Section 1: Basic Math Answers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Mean vs Median: mean is the average, median is the middle value (less sensitive to outliers)\n",
    "# Annual return ≈ 0.0005 * 252 = 0.126 (12.6%)\n",
    "# Annual std dev ≈ 0.02 * sqrt(252) ≈ 0.317 (31.7%)\n",
    "# Drawdown: the percentage decline from the portfolio's peak to trough"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Section 2.1 – Cumulative Return Curve"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def cumulative_return_curve(returns):\n",
    "    return (1 + returns).cumprod()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Section 2.2 – Max Drawdown"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_max_drawdown(cum_returns):\n",
    "    peak = cum_returns.cummax()\n",
    "    drawdown = cum_returns / peak - 1\n",
    "    return drawdown.min()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Section 3.1 – Simulate Return Paths"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "mu = 0.0004\n",
    "sigma = 0.01\n",
    "n_days = 252\n",
    "n_sims = 1000\n",
    "\n",
    "simulated = np.cumprod(1 + np.random.normal(mu, sigma, (n_days, n_sims)), axis=0)\n",
    "ending = simulated[-1]\n",
    "\n",
    "p5, med = np.percentile(ending, [5, 50])\n",
    "print(f"5th percentile: {p5:.2f}, Median: {med:.2f}")\n",
    "\n",
    "plt.plot(simulated[:, :50], alpha=0.3)\n",
    "plt.title("Sample Simulated Paths")\n",
    "plt.xlabel("Days")\n",
    "plt.ylabel("Wealth")\n",
    "plt.show()"
   ]
  }
