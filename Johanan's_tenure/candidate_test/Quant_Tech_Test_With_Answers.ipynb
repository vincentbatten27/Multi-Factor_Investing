    "# 🧪 Quant Technical Test (Full + Simplified Versions with Answers)\n",
    "This notebook contains two versions of a technical interview test for candidates entering a quant finance team: an **advanced version** and a **simplified version**.\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🔍 Full Version (Advanced Level)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Section 1: Removed Factor Questions (Can be asked in discussion)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Section 2.1 – Low Volatility Selector"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def low_volatility_selector(returns_df):\n",
    "    rolling_vol = returns_df.rolling(60).std()\n",
    "    zscores = (rolling_vol - rolling_vol.mean(axis=1).values[:, None]) / rolling_vol.std(axis=1).values[:, None]\n",
    "    selected = zscores.apply(lambda row: row.nsmallest(int(0.1 * len(row))).index.tolist(), axis=1)\n",
    "    return selected"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Section 2.2 – Risk-adjusted Performance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def risk_adjusted_perf(returns_df):\n",
    "    daily_returns = returns_df.mean(axis=1)\n",
    "    ann_return = (1 + daily_returns.mean()) ** 252 - 1\n",
    "    ann_vol = daily_returns.std() * (252 ** 0.5)\n",
    "    sharpe = ann_return / ann_vol\n",
    "    return ann_return, ann_vol, sharpe"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Section 2.3 – Monte Carlo 3-Factor Simulation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "def monte_carlo_3factor(n=1000):\n",
    "    weights = np.array([0.4, 0.35, 0.25])\n",
    "    mu = np.array([0.04, 0.02, 0.03]) / 252\n",
    "    sigma = np.array([0.20, 0.15, 0.10]) / (252 ** 0.5)\n",
    "    T = 252\n",
    "    results = []\n",
    "    for _ in range(n):\n",
    "        factor_returns = np.random.normal(mu, sigma, (T, 3))\n",
    "        port_return = factor_returns @ weights\n",
    "        final = np.prod(1 + port_return)\n",
    "        results.append(final)\n",
    "    return np.percentile(results, [5, 50])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 🧮 Simplified Version (Beginner Level)"
   ]
  },
  {
   "cell_type": "markdown",
